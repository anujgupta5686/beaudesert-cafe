# Backend API base (must include /api)
#
# Local (`npm run dev`): uses `.env.development` → http://localhost:5000/api
# Development / Production: set VITE_API_URL in Vercel (or `.env.production` locally)
#
# Vercel example:
# VITE_API_URL=https://your-backend.onrender.com/api

VITE_API_URL=http://localhost:5000/api

# Optional
# VITE_ADMIN_EMAIL=admin@cafe.com
