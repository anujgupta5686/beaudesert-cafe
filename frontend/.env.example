# Backend API base (must include /api)
# Switch this when moving between local / Render / EC2 — rebuild after change.

# LOCAL
VITE_API_URL=http://localhost:5000/api

# DEVELOPMENT (Render example)
# VITE_API_URL=https://your-backend.onrender.com/api

# PRODUCTION (AWS EC2 / custom domain — fill later)
# VITE_API_URL=https://api.yourdomain.com/api

# Optional
# VITE_ADMIN_EMAIL=admin@cafe.com
