# =============================================================================
# Beaudesert Cafe API — environment template
# Copy to `.env` for local. On Render/Vercel, set the same keys in the dashboard.
# =============================================================================

# --- Runtime ---
# local | development | production
APP_ENV=local
NODE_ENV=development
PORT=5000

# Public API origin (no /api).
# Local: leave as localhost OR omit (auto → http://localhost:PORT)
# Render: omit to use RENDER_EXTERNAL_URL, or set explicitly:
# BACKEND_URL=https://your-api.onrender.com
BACKEND_URL=http://localhost:5000

# Frontend origin (CORS + email / feedback links)
FRONTEND_URL=http://localhost:5173
# ALLOWED_ORIGINS=https://extra-preview.vercel.app
FEEDBACK_EXPIRY_DAYS=30

# --- Database ---
# IMPORTANT: Localhost only shows the data in THIS URI.
# To test with the same products/orders as Render/development, paste that Atlas
# connection string into MONGODB_URI (not a blank local cafe_db).
#
# Local empty DB (optional):
# MONGODB_URI=mongodb://localhost:27017/cafe_db
#
# Shared development Atlas (recommended for local QA against real data):
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/cafe_db?retryWrites=true&w=majority

# Production MongoDB (client-provided) — paste later, then either:
#   A) swap MONGODB_URI on the prod host, OR
#   B) set MONGODB_URI_PRODUCTION + APP_ENV=production
# MONGODB_URI_PRODUCTION=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/cafe_db?retryWrites=true&w=majority

# --- Auth ---
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# --- Email (SMTP) — REQUIRED on Render for order placed + order completed mails ---
# Gmail: enable 2FA → create App Password → paste 16 chars (spaces OK, stripped)
MAIL_HOST=smtp.gmail.com
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
ADMIN_EMAIL=admin@cafe.com
# MAIL_PORT=587

# =============================================================================
# STORAGE
# Auto (recommended):
#   - Local machine  → local disk (backend/uploads)
#   - Render / hosted → cloudinary
# Override anytime with STORAGE_PROVIDER=local|cloudinary|s3
# =============================================================================
# STORAGE_PROVIDER=local

# Cloudinary (required on Render/dev when using cloudinary)
CLOUD_NAME=
API_KEY=
API_SECRET=

# AWS S3 (EC2 / production — set STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
# AWS_S3_PUBLIC_URL=https://cdn.yourdomain.com
AWS_S3_KEY_PREFIX=beaudesert-cafe

REDIS_URL=

# =============================================================================
# LOCAL (npm run dev)
#   APP_ENV=local
#   FRONTEND_URL=http://localhost:5173
#   BACKEND_URL=http://localhost:5000
#   (storage auto = local; or STORAGE_PROVIDER=local)
#   frontend .env.development → VITE_API_URL=http://localhost:5000/api
#
# DEVELOPMENT (GitHub → Render + Vercel)
#   APP_ENV=development
#   FRONTEND_URL=https://YOUR-APP.vercel.app
#   BACKEND_URL=https://YOUR-API.onrender.com   (or rely on RENDER_EXTERNAL_URL)
#   CLOUD_NAME / API_KEY / API_SECRET = set
#   (storage auto = cloudinary on Render)
#   Vercel env → VITE_API_URL=https://YOUR-API.onrender.com/api
#
# PRODUCTION (AWS EC2 later)
#   APP_ENV=production
#   STORAGE_PROVIDER=s3
#   BACKEND_URL + FRONTEND_URL = your domains
# =============================================================================
