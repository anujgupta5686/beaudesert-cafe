# Server
PORT=5000
NODE_ENV=development

# Database (Atlas URI for Render)
MONGODB_URI=mongodb://localhost:27017/cafe_db

# Auth
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Email (SMTP) — required for OTP, order mail, contact alerts
MAIL_HOST=smtp.gmail.com
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
ADMIN_EMAIL=admin@cafe.com

# Frontend URL (Vercel production URL) — used for feedback links + CORS
FRONTEND_URL=http://localhost:5173
# Optional: comma-separated extra CORS origins (preview URLs, etc.)
# ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-preview.vercel.app
FEEDBACK_EXPIRY_DAYS=30

# Storage: cloudinary | s3
STORAGE_PROVIDER=cloudinary

# Cloudinary (required if STORAGE_PROVIDER=cloudinary)
CLOUD_NAME=your_cloud_name
API_KEY=your_api_key
API_SECRET=your_api_secret
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# AWS S3 (optional — later for AWS deploy)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Redis (optional — enables BullMQ email queue; leave empty on Render free)
REDIS_URL=
