# Copy to backend/.env on EC2 (NEVER commit real secrets)
# nano ~/apps/beaudesert-cafe/backend/.env

PORT=5000
APP_ENV=production
NODE_ENV=production

MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/cafe_db?retryWrites=true&w=majority&appName=Cluster0

JWT_SECRET=replace_with_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# After GoDaddy DNS + SSL, set real HTTPS URLs:
BACKEND_URL=https://api.YOUR_DOMAIN.com
FRONTEND_URL=https://YOUR_DOMAIN.com
FEEDBACK_EXPIRY_DAYS=30

MAIL_HOST=smtp.gmail.com
MAIL_USER=beaudesertcafe@gmail.com
MAIL_PASS=your_16_char_gmail_app_password
ADMIN_EMAIL=beaudesertcafe@gmail.com

STORAGE_PROVIDER=cloudinary
CLOUD_NAME=your_cloud_name
API_KEY=your_api_key
API_SECRET=your_api_secret
