# =============================================================================
# Beaudesert Cafe API — environment template
# Copy to `.env` and fill values. Switch environments by changing this file
# (and frontend VITE_API_URL) — no code changes needed.
# =============================================================================

# --- Runtime ---
# local | development | production
APP_ENV=local
NODE_ENV=development
PORT=5000

# Public API origin (no /api). Used for local disk image URLs + health logs.
# Local:  http://localhost:5000
# Render: https://your-api.onrender.com
# EC2:    https://api.yourdomain.com
BACKEND_URL=http://localhost:5000

# Frontend origin (CORS + email / feedback links)
# Local:  http://localhost:5173
# Vercel: https://your-app.vercel.app
# EC2:    https://yourdomain.com
FRONTEND_URL=http://localhost:5173
# ALLOWED_ORIGINS=https://extra-preview.vercel.app
FEEDBACK_EXPIRY_DAYS=30

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/cafe_db

# --- Auth ---
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# --- Email (SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
ADMIN_EMAIL=admin@cafe.com

# =============================================================================
# STORAGE — pick ONE
#   local      → files in backend/uploads (best for local Windows testing)
#   cloudinary → optional shared/dev cloud
#   s3         → AWS S3 (use on EC2 / production; also fine for Render)
# =============================================================================
STORAGE_PROVIDER=cloudinary

# --- Cloudinary (required if STORAGE_PROVIDER=cloudinary) ---
CLOUD_NAME=
API_KEY=
API_SECRET=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- AWS S3 (only if STORAGE_PROVIDER=s3) ---
# On EC2 you can omit keys and use an IAM instance role instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
# Optional CloudFront / custom domain (no trailing slash)
# AWS_S3_PUBLIC_URL=https://cdn.yourdomain.com
# Folder prefix inside the bucket
AWS_S3_KEY_PREFIX=beaudesert-cafe

# --- Redis (optional email queue) ---
REDIS_URL=

# =============================================================================
# QUICK SWITCH CHEAT SHEET
# -----------------------------------------------------------------------------
# LOCAL
#   APP_ENV=local
#   STORAGE_PROVIDER=local
#   BACKEND_URL=http://localhost:5000
#   FRONTEND_URL=http://localhost:5173
#   frontend/.env → VITE_API_URL=http://localhost:5000/api
#
# GITHUB → Render/Vercel (development)
#   APP_ENV=development
#   STORAGE_PROVIDER=cloudinary   (or s3 if bucket ready)
#   BACKEND_URL=https://YOUR-API.onrender.com
#   FRONTEND_URL=https://YOUR-APP.vercel.app
#   Vercel env → VITE_API_URL=https://YOUR-API.onrender.com/api
#
# AWS EC2 (production) — you'll add domain later
#   APP_ENV=production
#   NODE_ENV=production
#   STORAGE_PROVIDER=s3
#   BACKEND_URL=https://api.YOURDOMAIN.com
#   FRONTEND_URL=https://YOURDOMAIN.com
#   AWS_S3_BUCKET=...
#   AWS_REGION=...
#   (keys OR IAM role)
#   frontend build → VITE_API_URL=https://api.YOURDOMAIN.com/api
# =============================================================================
